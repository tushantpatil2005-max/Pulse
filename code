# CLI
# ---------------------------------------------------------------------------


def main():
    import argparse

    parser = argparse.ArgumentParser(description="Dynamic Multi-Modal Personalization System")
    parser.add_argument("--check", action="store_true", help="Run self-check suite")
    parser.add_argument("--user-id", default="demo_user")
    parser.add_argument("--segment", default="loyal", choices=["loyal", "churn_risk", "new", "high_value"])
    parser.add_argument("--channel", default="email", choices=["email", "social", "web", "push"])
    parser.add_argument("--modality", default="both", choices=["text", "image", "both"])
    parser.add_argument("--interests", default="desk setup,sustainable materials")
    parser.add_argument("--remote", action="store_true")
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8001)
    args = parser.parse_args()

    if args.check:
        notes = asyncio.run(self_check())
        print("PASS")
        for n in notes:
            print(n)
        return

    if args.serve:
        if not HAS_FASTAPI:
            raise SystemExit("Install fastapi and uvicorn: pip install fastapi uvicorn")
        import uvicorn

        uvicorn.run(app, host=args.host, port=args.port)
        return

    profile = UserProfile(
        user_id=args.user_id,
        segment=args.segment,
        interests=[s.strip() for s in args.interests.split(",") if s.strip()],
        recent_actions=["viewed collection"],
        preferred_tone="warm",
    )
    system = PersonalizationSystem(remote_models=args.remote)
    result = asyncio.run(
        system.generate(
            profile,
            channel=args.channel,
            modality=args.modality,
            remote_models=args.remote,
        )
    )
    # Omit huge SVG in CLI print for readability
    if result.get("image") and result["image"].get("svg"):
        result["image"] = {**result["image"], "svg": f"<svg… {len(result['image']['svg'])} chars>"}
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()

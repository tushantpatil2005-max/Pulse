if HAS_FASTAPI:
    app = FastAPI(title="Pulse Personalization API", version="1.0.0")
    _system = PersonalizationSystem(remote_models=False)

    class ProfileBody(BaseModel):
        user_id: str = "anon"
        segment: str = "new"
        interests: list[str] = Field(default_factory=list)
        recent_actions: list[str] = Field(default_factory=list)
        locale: str = "en-US"
        preferred_tone: str = "warm"
        engagement_score: float = 0.5

    class GenerateBody(BaseModel):
        profile: ProfileBody
        channel: str = "email"
        modality: str = "both"
        campaign: str = "spring_refresh"
        product_hint: Optional[str] = None
        remote_models: bool = False

    @app.get("/health")
    def health():
        return {"ok": True, "system": "pulse", "sla_ms": SLA_MS, "stats": _system.stats()}

    @app.get("/metrics")
    def metrics():
        return _system.monitor.snapshot()

    @app.post("/generate")
    async def generate(body: GenerateBody):
        try:
            return await _system.generate(
                profile=body.profile.model_dump(),
                channel=body.channel,
                modality=body.modality,
                campaign=body.campaign,
                product_hint=body.product_hint,
                remote_models=body.remote_models,
            )
        except RuntimeError as e:
            raise HTTPException(status_code=503, detail=str(e)) from e

    @app.post("/generate/batch")
    async def generate_batch(bodies: list[GenerateBody]):
        reqs = [
            {
                "profile": b.profile.model_dump(),
                "channel": b.channel,
                "modality": b.modality,
                "campaign": b.campaign,
                "product_hint": b.product_hint,
                "remote_models": b.remote_models,
            }
            for b in bodies
        ]
        return await _system.generate_many(reqs)



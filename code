# Self-check
# ---------------------------------------------------------------------------


async def self_check() -> list[str]:
    notes: list[str] = []
    system = PersonalizationSystem(remote_models=False)
    assert system.stats()["brand_docs"] >= 5
    assert system.stats()["chunks"] >= system.stats()["brand_docs"]

    loyal = UserProfile(
        user_id="u_loyal",
        segment="loyal",
        interests=["desk setup", "sustainable materials"],
        recent_actions=["viewed Lumen Lamp", "opened spring email"],
        preferred_tone="warm",
        engagement_score=0.9,
    )
    r1 = await system.generate(loyal, channel="email", modality="both", campaign="spring_refresh")
    notes.append(f"loyal decision product={r1['text']['product']} ms={r1['timings']['total_ms']}")
    assert r1["timings"]["within_sla"] and r1["timings"]["total_ms"] <= 3000
    assert r1["text"] and "Lumen Lamp" in r1["text"]["body"]
    assert r1["image"] and r1["image"]["svg"].startswith("<svg")
    assert len(r1["brand_citations"]) >= 2
    assert brand_safe(r1["text"]["body"])
    assert "last chance" not in r1["text"]["body"].lower()

    churn = UserProfile(
        user_id="u_churn",
        segment="churn_risk",
        interests=["coffee"],
        recent_actions=["ignored last two emails"],
        preferred_tone="professional",
        engagement_score=0.2,
    )
    r2 = await system.generate(churn, channel="push", modality="text", product_hint="mug")
    notes.append(f"churn body={r2['text']['body']}")
    assert "Harbor Mug" in r2["text"]["body"]
    assert r2["image"] is None
    assert r2["timings"]["within_sla"]

    # Concurrent burst
    burst_profiles = [
        {
            "profile": {
                "user_id": f"u_{i}",
                "segment": "new",
                "interests": ["small spaces"],
                "recent_actions": ["signed up"],
                "preferred_tone": "warm",
            },
            "channel": "social",
            "modality": "both",
        }
        for i in range(6)
    ]
    burst = await system.generate_many(burst_profiles)
    assert len(burst) == 6
    assert all(b["timings"]["within_sla"] for b in burst)
    notes.append("burst ms: " + ", ".join(str(b["timings"]["total_ms"]) for b in burst))

    # Fallback path: arm failure then enable remote so retry/fallback is exercised
    system.arm_llama_failure()
    system2 = system
    # Simulate remote path with forced failure → grounded fallback still works
    r3 = await system2.generate(
        loyal, channel="email", modality="text", remote_models=True
    )
    assert r3["text"]["body"]
    assert any("fallback" in t["status"] or "503" in str(r3["failures"]) or r3["text"]["writer"]
               for t in r3["trace"]) or r3["text"]
    notes.append(f"fallback route={r3['model_route']}")

    # Monitoring populated
    snap = system.monitor.snapshot()
    assert snap["totals"]["count"] >= 8
    notes.append(f"monitor count={snap['totals']['count']} avg_ms={snap['totals']['avg_ms']:.1f}")

    # RAG hits differ by interest
    sofa_user = UserProfile(
        user_id="u_sofa",
        segment="high_value",
        interests=["sofa", "living room"],
        recent_actions=["viewed Nest Sofa"],
        preferred_tone="professional",
    )
    r4 = await system.generate(sofa_user, channel="web", modality="text")
    assert "Nest Sofa" in r4["text"]["body"]
    notes.append(f"sofa product={r4['text']['product']}")

    return notes



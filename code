def llama_complete(
    base_url: str,
    model: str,
    messages: list[dict],
    max_tokens: int = 280,
    timeout: float = 1.2,
    api_key: Optional[str] = None,
) -> dict:
    url = base_url.rstrip("/") + "/v1/chat/completions"
    body = json.dumps(
        {
            "model": model,
            "temperature": 0.2,
            "max_tokens": max_tokens,
            "messages": messages,
        }
    ).encode()
    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    req = Request(url, data=body, headers=headers, method="POST")
    with urlopen(req, timeout=timeout) as resp:
        data = json.loads(resp.read().decode())
    choice = (data.get("choices") or [{}])[0]
    msg = choice.get("message") or {}
    usage = data.get("usage") or {}
    content = msg.get("content") or ""
    return {
        "content": content,
        "tokens_in": usage.get("prompt_tokens", estimate_tokens("\n".join(m["content"] for m in messages))),
        "tokens_out": usage.get("completion_tokens", estimate_tokens(content)),
        "model": model,
    }


FORBIDDEN_PATTERNS = [
    r"\d+\s*%\s*off",
    r"free shipping",
    r"last chance",
    r"next[- ]day",
    r"limited time only",
    # No machine-origin labels on customer-facing copy
    r"ai[- ]generated",
    r"generated by (ai|an? (ai|llm|model))",
    r"as an ai",
    r"language model",
    r"chatgpt|claude\.ai|openai",
    r"this (content|copy|text) was (automatically )?generated",
    r"powered by ai",
    r"\bllm\b",
]


def strip_machine_labels(text: str) -> str:
    """Remove origin labels so published copy stays unmarked."""
    cleaned = re.sub(
        r"(?i)\s*[\(\[]?\s*(ai[- ]generated|generated by (ai|an? (ai|llm|model))|"
        r"as an ai[\w\s]*|powered by ai|created with (ai|chatgpt))\s*[\)\]]?\s*",
        " ",
        text,
    )
    return re.sub(r"\s{2,}", " ", cleaned).strip()


def brand_safe(text: str) -> bool:
    lower = text.lower()
    for pat in FORBIDDEN_PATTERNS:
        if re.search(pat, lower):
            return False
    if re.search(r"better than (ikea|wayfair|amazon)", lower):
        return False
    return True


def accept_polish(draft: str, polished: str) -> bool:
    polished = strip_machine_labels(polished)
    if len(polished.strip()) < 20:
        return False
    if not brand_safe(polished):
        return False
    draft_nums = set(re.findall(r"\d+", draft))
    allowed = draft_nums | {"2", "3", "350"}
    for n in re.findall(r"\d+", polished):
        if n not in allowed:
            return False
    return True



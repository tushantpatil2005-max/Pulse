# ---------------------------------------------------------------------------
# Hybrid RAG index
# ---------------------------------------------------------------------------


@dataclass
class Chunk:
    id: str
    doc_id: str
    title: str
    source: str
    text: str
    toks: list[str]
    tf: Counter
    vec: list[float]


class BrandIndex:
    def __init__(self, docs: list[dict]):
        self.chunks: list[Chunk] = []
        self.df: Counter = Counter()
        for doc in docs:
            for i, text in enumerate(chunk_text(doc["text"])):
                toks = tokens(text)
                self.chunks.append(
                    Chunk(
                        id=f"{doc['id']}:{i}",
                        doc_id=doc["id"],
                        title=doc["title"],
                        source=doc["source"],
                        text=text,
                        toks=toks,
                        tf=Counter(toks),
                        vec=embed(text),
                    )
                )
        for c in self.chunks:
            for term in set(c.toks):
                self.df[term] += 1
        total = sum(len(c.toks) for c in self.chunks) or 1
        self.avg_len = total / max(1, len(self.chunks))

    def _bm25(self, chunk: Chunk, q_tokens: list[str]) -> float:
        N = len(self.chunks)
        dl = len(chunk.toks) or 1
        score = 0.0
        seen = set()
        for term in q_tokens:
            if term in seen:
                continue
            seen.add(term)
            tf = chunk.tf.get(term, 0)
            if not tf:
                continue
            df = self.df.get(term, 0)
            idf = math.log(1 + (N - df + 0.5) / (df + 0.5))
            denom = tf + BM25_K1 * (1 - BM25_B + BM25_B * (dl / self.avg_len))
            score += idf * ((tf * (BM25_K1 + 1)) / denom)
        return score

    def search(self, query: str, k: int = 5) -> list[dict]:
        q_tokens = tokens(query)
        if not q_tokens or not self.chunks:
            return []
        q_vec = embed(query)
        bm = [self._bm25(c, q_tokens) for c in self.chunks]
        dense = [max(0.0, cosine(q_vec, c.vec)) for c in self.chunks]

        def ranks(values: list[float]) -> list[int]:
            order = sorted(range(len(values)), key=lambda i: values[i], reverse=True)
            r = [0] * len(values)
            for rank, i in enumerate(order, 1):
                r[i] = rank
            return r

        bm_r, den_r = ranks(bm), ranks(dense)
        hits = []
        for i, c in enumerate(self.chunks):
            rrf = 1 / (RRF_K + bm_r[i]) + 1 / (RRF_K + den_r[i])
            cover = coverage(query, c.text)
            score = rrf * 0.55 + dense[i] * 0.25 + cover * 0.2
            hits.append(
                {
                    "id": c.id,
                    "doc_id": c.doc_id,
                    "title": c.title,
                    "source": c.source,
                    "text": c.text,
                    "score": score,
                }
            )
        hits.sort(key=lambda h: h["score"], reverse=True)
        return hits[:k]



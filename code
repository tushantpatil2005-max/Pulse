PRODUCT_KEYWORDS = {
    "lumen": "Lumen Lamp",
    "lamp": "Lumen Lamp",
    "nest": "Nest Sofa",
    "sofa": "Nest Sofa",
    "harbor": "Harbor Mug",
    "mug": "Harbor Mug",
}


def pick_product(profile: UserProfile, hint: Optional[str], campaign: str) -> str:
    blob = " ".join(profile.interests + profile.recent_actions + ([hint] if hint else [])).lower()
    for key, name in PRODUCT_KEYWORDS.items():
        if key in blob:
            return name
    if campaign == "spring_refresh":
        return "Lumen Lamp"
    return "Harbor Mug"


def pick_benefit(product: str, hits: list[dict]) -> str:
    joined = " ".join(h["text"] for h in hits).lower()
    if product == "Lumen Lamp":
        if "recycled" in joined:
            return "recycled aluminum and quiet desk light"
        return "dimmable light for focused work"
    if product == "Nest Sofa":
        return "modular comfort with washable covers"
    return "a calmer morning ritual"


def grounded_text(
    profile: UserProfile,
    channel: str,
    campaign: str,
    product: str,
    benefit: str,
    hits: list[dict],
) -> dict:
    segment = profile.segment.replace("_", " ")
    tone = profile.preferred_tone
    cta = "Explore the collection"
    if channel == "push":
        cta = "See the pick"
    elif channel == "social":
        cta = "Save for later"

    if profile.segment == "churn_risk":
        body = (
            f"{product} brings {benefit}. "
            f"When you are ready, {cta.lower()} — no rush."
        )
        subject = f"{product} when you need it"
    elif profile.segment == "loyal":
        body = (
            f"Thanks for staying with Aurora Home. "
            f"Your {segment} picks point to {product}: {benefit}. "
            f"{cta}."
        )
        subject = f"A {product} note for you"
    elif profile.segment == "high_value":
        body = (
            f"{product} is built for lasting materials — {benefit}. "
            f"{cta}."
        )
        subject = f"{product}, made to last"
    else:  # new
        body = (
            f"Meet {product}: {benefit}. "
            f"A simple place to start at Aurora Home. {cta}."
        )
        subject = f"Meet {product}"

    if tone == "playful" and profile.segment != "churn_risk":
        body = body.replace("brings", "sets up").replace("Meet", "Say hello to")
    elif tone == "professional":
        body = body.replace("Thanks for staying with Aurora Home. ", "")

    if channel == "social":
        body = f"{product} — {benefit}. {cta}."
        subject = None
    if channel == "push":
        body = f"{product}: {benefit}."
        subject = None

    voice_bits = [h["text"][:120] for h in hits[:2]]
    return {
        "subject": subject,
        "body": body,
        "cta": cta,
        "product": product,
        "benefit": benefit,
        "tone": tone,
        "channel": channel,
        "campaign": campaign,
        "grounded_from": voice_bits,
        "writer": "grounded-template",
    }


def grounded_image_spec(
    profile: UserProfile,
    product: str,
    benefit: str,
    channel: str,
    hits: list[dict],
) -> dict:
    ratio = "1:1" if channel in ("social", "push") else "16:9"
    scene = {
        "Lumen Lamp": "Lumen Lamp on a pale oak desk beside a notebook, soft morning light",
        "Nest Sofa": "Nest Sofa corner with a linen throw, quiet living room, natural light",
        "Harbor Mug": "Harbor Mug beside an open notebook on a cream tabletop",
    }.get(product, f"{product} in a calm interior")
    caption = f"{product} — {benefit}"[:80]
    prompt = (
        f"Still life product photo, {scene}, cream and sage palette, no people, "
        f"no logos, natural light, brand Aurora Home, aspect {ratio}"
    )
    # Deterministic SVG banner (no external image API required)
    svg = _svg_banner(product, caption, ratio)
    return {
        "prompt": prompt,
        "caption": caption,
        "aspect_ratio": ratio,
        "palette": ["#F5F0E8", "#8FAF8A", "#2C2C2C"],
        "svg": svg,
        "format": "image/svg+xml",
        "writer": "grounded-visual",
        "visual_notes": [h["text"][:100] for h in hits if h["doc_id"] == "visual"][:1],
    }


def _svg_banner(product: str, caption: str, ratio: str) -> str:
    w, h = (1080, 1080) if ratio == "1:1" else (1280, 720)
    # Simple product glyph
    glyph = {
        "Lumen Lamp": f'<circle cx="{w//2}" cy="{h//2-40}" r="48" fill="none" stroke="#8FAF8A" stroke-width="8"/>'
        f'<line x1="{w//2}" y1="{h//2+8}" x2="{w//2}" y2="{h//2+90}" stroke="#2C2C2C" stroke-width="6"/>',
        "Nest Sofa": f'<rect x="{w//2-90}" y="{h//2-20}" width="180" height="70" rx="12" fill="#8FAF8A" opacity="0.5"/>'
        f'<rect x="{w//2-100}" y="{h//2+40}" width="200" height="18" rx="4" fill="#2C2C2C"/>',
        "Harbor Mug": f'<path d="M{w//2-35} {h//2-50} h50 v90 a25 25 0 0 1 -50 0 z" fill="none" stroke="#8FAF8A" stroke-width="7"/>'
        f'<path d="M{w//2+15} {h//2-20} h22 a18 18 0 0 1 0 36 h-22" fill="none" stroke="#2C2C2C" stroke-width="6"/>',
    }.get(
        product,
        f'<rect x="{w//2-60}" y="{h//2-40}" width="120" height="80" rx="10" fill="#8FAF8A"/>',
    )
    safe_caption = (
        caption.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    )
    return (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{w}" height="{h}" viewBox="0 0 {w} {h}">'
        f'<rect width="{w}" height="{h}" fill="#F5F0E8"/>'
        f"{glyph}"
        f'<text x="{w//2}" y="{h-48}" text-anchor="middle" font-family="Georgia, serif" '
        f'font-size="28" fill="#2C2C2C">{safe_caption}</text>'
        f'<text x="{w//2}" y="48" text-anchor="middle" font-family="system-ui,sans-serif" '
        f'font-size="16" letter-spacing="3" fill="#8FAF8A">AURORA HOME</text>'
        f"</svg>"
    )



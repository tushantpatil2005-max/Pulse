class Monitor:
    def __init__(self):
        self.requests: list[dict] = []
        self.totals = {
            "count": 0,
            "errors": 0,
            "fallbacks": 0,
            "avg_ms": 0.0,
            "within_sla": 0,
        }

    def record(self, result: GenerationResult):
        total_ms = result.timings.get("total_ms", 0)
        self.totals["count"] += 1
        n = self.totals["count"]
        self.totals["avg_ms"] = self.totals["avg_ms"] + (total_ms - self.totals["avg_ms"]) / n
        if result.timings.get("within_sla"):
            self.totals["within_sla"] += 1
        if result.failures:
            self.totals["errors"] += 1
        if any(r.endswith("fallback") or r == "grounded-template" or "failed" in r for r in result.model_route):
            self.totals["fallbacks"] += 1
        entry = {
            "id": result.id,
            "user_id": result.user_id,
            "channel": result.channel,
            "modality": result.modality,
            "total_ms": total_ms,
            "within_sla": result.timings.get("within_sla"),
            "model_route": result.model_route,
            "failures": len(result.failures),
        }
        self.requests.append(entry)
        self.requests = self.requests[-200:]
        log.info(
            "gen id=%s user=%s channel=%s modality=%s ms=%.1f sla=%s route=%s",
            result.id,
            result.user_id,
            result.channel,
            result.modality,
            total_ms,
            result.timings.get("within_sla"),
            "->".join(result.model_route),
        )

    def snapshot(self) -> dict:
        return {
            "totals": dict(self.totals),
            "recent": list(self.requests[-20:]),
        }



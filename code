class PersonalizationSystem:
    def __init__(
        self,
        sla_ms: int = SLA_MS,
        llama_base: str = LLAMA_BASE,
        llama_models: Optional[list[str]] = None,
        api_key: Optional[str] = None,
        max_concurrent: int = MAX_CONCURRENT,
        remote_models: bool = False,
    ):
        self.index = BrandIndex(seed_brand_corpus())
        self.sla_ms = sla_ms
        self.llama_base = llama_base
        self.llama_models = llama_models or list(LLAMA_MODELS)
        self.api_key = api_key
        self.max_concurrent = max_concurrent
        self.remote_models_default = remote_models
        self.monitor = Monitor()
        self._sem = asyncio.Semaphore(max_concurrent)
        self._waiting = 0
        self._fail_llama_once = False

    def arm_llama_failure(self):
        """Test hook: next Llama call fails once."""
        self._fail_llama_once = True

    def stats(self) -> dict:
        return {
            "brand_docs": len({c.doc_id for c in self.index.chunks}),
            "chunks": len(self.index.chunks),
            "max_concurrent": self.max_concurrent,
            "sla_ms": self.sla_ms,
            "monitor": self.monitor.snapshot()["totals"],
        }

    async def generate(
        self,
        profile: UserProfile | dict,
        channel: str = "email",
        modality: str = "both",
        campaign: str = "spring_refresh",
        product_hint: Optional[str] = None,
        remote_models: Optional[bool] = None,
    ) -> dict:
        if isinstance(profile, dict):
            profile = UserProfile(
                user_id=profile.get("user_id", "anon"),
                segment=profile.get("segment", "new"),
                interests=list(profile.get("interests") or []),
                recent_actions=list(profile.get("recent_actions") or []),
                locale=profile.get("locale", "en-US"),
                preferred_tone=profile.get("preferred_tone", "warm"),
                engagement_score=float(profile.get("engagement_score", 0.5)),
            )
        if self._waiting > 64:
            raise RuntimeError("Generation queue is full. Retry shortly.")
        self._waiting += 1
        try:
            async with self._sem:
                self._waiting -= 1
                return await self._generate_unlocked(
                    profile,
                    channel,
                    modality,
                    campaign,
                    product_hint,
                    self.remote_models_default if remote_models is None else remote_models,
                )
        except Exception:
            self._waiting = max(0, self._waiting - 1)
            raise

    async def generate_many(self, requests: list[dict]) -> list[dict]:
        return await asyncio.gather(*(self.generate(**req) for req in requests))

    async def _generate_unlocked(
        self,
        profile: UserProfile,
        channel: str,
        modality: str,
        campaign: str,
        product_hint: Optional[str],
        remote_models: bool,
    ) -> dict:
        t0 = time.time()
        deadline = t0 + self.sla_ms / 1000.0
        trace: list[TraceEvent] = []
        failures: list[dict] = []
        model_route: list[str] = []
        tokens_in = 0
        tokens_out = 0

        def step(name: str, status: str, detail: str, lat: float = 0, tin: int = 0, tout: int = 0):
            nonlocal tokens_in, tokens_out
            tokens_in += tin
            tokens_out += tout
            trace.append(
                TraceEvent(name, status, detail, lat, tin, tout)
            )

        step(
            "accept",
            "ok",
            f"user={profile.user_id} segment={profile.segment} channel={channel} modality={modality}",
        )

        # RAG retrieval for brand voice + context
        query = (
            f"{campaign} {channel} {profile.segment} {profile.preferred_tone} "
            f"{' '.join(profile.interests)} {' '.join(profile.recent_actions)} "
            f"{product_hint or ''} brand voice product"
        )
        t_rag = time.time()
        hits = self.index.search(query, k=5)
        step(
            "rag_retrieve",
            "ok",
            f"Retrieved {len(hits)} brand chunks (BM25 + dense + RRF).",
            (time.time() - t_rag) * 1000,
            estimate_tokens(query),
            estimate_tokens(" ".join(h["text"][:160] for h in hits)),
        )

        product = pick_product(profile, product_hint, campaign)
        benefit = pick_benefit(product, hits)
        citations = [
            {
                "id": str(i + 1),
                "doc_id": h["doc_id"],
                "title": h["title"],
                "source": h["source"],
                "excerpt": h["text"][:220],
                "score": round(h["score"], 4),
            }
            for i, h in enumerate(hits)
        ]

        text_out: Optional[dict] = None
        image_out: Optional[dict] = None

        need_text = modality in ("text", "both")
        need_image = modality in ("image", "both")

        if need_text:
            draft = grounded_text(profile, channel, campaign, product, benefit, hits)
            text_out = draft
            model_route.append("grounded-template")
            step("text_grounded", "ok", f"Template writer produced {channel} copy for {product}.")

            if remote_models and time.time() < deadline:
                polished, route_note, tin, tout, failed = await self._llama_polish(
                    draft, hits, profile, deadline, failures
                )
                tokens_in += tin
                tokens_out += tout
                if polished:
                    body = strip_machine_labels(polished)
                    text_out = {**draft, "body": body, "writer": route_note}
                    model_route.append(route_note)
                    step("text_llama", "ok", f"Llama polished body via {route_note}.", tin=tin, tout=tout)
                else:
                    model_route.append(route_note or "llama:fallback")
                    step("text_llama", "fallback", route_note or "Llama unavailable; kept grounded template.")

            if text_out:
                text_out["body"] = strip_machine_labels(text_out.get("body", ""))
                if text_out.get("subject"):
                    text_out["subject"] = strip_machine_labels(text_out["subject"])
            if text_out and not brand_safe(text_out.get("body", "")):
                text_out = grounded_text(profile, channel, campaign, product, benefit, hits)
                model_route.append("compliance-rewrite")
                failures.append({"step": "compliance", "message": "Unsafe claim stripped", "recovered": True})
                step("compliance", "fallback", "Blocked disallowed claim language.")

        if need_image and time.time() < deadline:
            t_img = time.time()
            image_out = grounded_image_spec(profile, product, benefit, channel, hits)
            model_route.append("grounded-visual")
            step(
                "image_workflow",
                "ok",
                f"Image prompt + SVG banner ({image_out['aspect_ratio']}) for {product}.",
                (time.time() - t_img) * 1000,
            )

        total_ms = (time.time() - t0) * 1000
        within_sla = total_ms <= self.sla_ms
        step("done", "ok" if within_sla else "error", f"Finished in {total_ms:.1f}ms (SLA {self.sla_ms}ms).")

        result = GenerationResult(
            id=f"gen_{uuid.uuid4().hex[:8]}",
            user_id=profile.user_id,
            channel=channel,
            modality=modality,
            campaign=campaign,
            text=text_out,
            image=image_out,
            brand_citations=citations,
            model_route=model_route,
            timings={
                "total_ms": round(total_ms, 2),
                "within_sla": within_sla,
                "sla_ms": self.sla_ms,
            },
            trace=[asdict(e) for e in trace],
            failures=failures,
            monitoring={
                "tokens_in": tokens_in,
                "tokens_out": tokens_out,
                "rag_hits": len(hits),
            },
        )
        self.monitor.record(result)
        return asdict(result)

    async def _llama_polish(
        self,
        draft: dict,
        hits: list[dict],
        profile: UserProfile,
        deadline: float,
        failures: list[dict],
    ) -> tuple[Optional[str], str, int, int, bool]:
        context = "\n".join(f"- {h['text']}" for h in hits[:4])
        messages = [
            {
                "role": "system",
                "content": (
                    "You write short marketing copy for Aurora Home. "
                    "Stay faithful to the brand context. Do not invent discounts, free shipping, "
                    "or urgency. Keep product names exact. Rewrite the body only."
                ),
            },
            {
                "role": "user",
                "content": (
                    f"Segment: {profile.segment}\nTone: {profile.preferred_tone}\n"
                    f"Brand context:\n{context}\n\n"
                    f"Draft body:\n{draft['body']}\n\n"
                    "Rewrite the body in 1–3 short sentences. No subject line."
                ),
            },
        ]
        for model in self.llama_models:
            remaining = deadline - time.time()
            if remaining < 0.15:
                break
            for attempt in range(2):
                try:
                    if self._fail_llama_once:
                        self._fail_llama_once = False
                        raise RuntimeError("simulated Llama upstream 503")
                    resp = await asyncio.get_event_loop().run_in_executor(
                        None,
                        lambda m=model, rem=remaining: llama_complete(
                            self.llama_base,
                            m,
                            messages,
                            max_tokens=180,
                            timeout=min(1.2, rem),
                            api_key=self.api_key,
                        ),
                    )
                    body = resp["content"].strip()
                    body = re.sub(r"^(Body:|Copy:)\s*", "", body, flags=re.I).strip().strip('"')
                    body = strip_machine_labels(body)
                    if accept_polish(draft["body"] + context, body):
                        return body, model, resp["tokens_in"], resp["tokens_out"], False
                    failures.append(
                        {
                            "step": "llama_polish",
                            "message": f"{model} polish failed brand guard",
                            "recovered": True,
                        }
                    )
                    return None, f"{model}:polish-rejected", resp["tokens_in"], resp["tokens_out"], True
                except Exception as err:
                    failures.append(
                        {
                            "step": "llama_polish",
                            "message": str(err),
                            "recovered": attempt < 1 or model != self.llama_models[-1],
                        }
                    )
                    if attempt == 0:
                        await asyncio.sleep(0.02)
            # try next model
        return None, "grounded-template", 0, 0, True


